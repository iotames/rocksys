# 监听地址
# The default value is: ":8080"
ROCKSYS_LISTEN = ":8080"

# 默认后端
# The default value is: "http://127.0.0.1:8080"
ROCKSYS_UPSTREAM = "http://127.0.0.1:8080"

# 转发超时(秒)
# The default value is: 5
ROCKSYS_TIMEOUT = 5

# 配置文件路径
# The default value is: ""
ROCKSYS_CONFIG = ""

# 管理接口地址
# The default value is: "127.0.0.1:19527"
ROCKSYS_ADMIN = "127.0.0.1:19527"

# 日志级别
# The default value is: "info"
ROCKSYS_LOG_LEVEL = "info"