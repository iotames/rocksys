#!/usr/bin/env bash
# commit-msg 钩子：校验提交信息首行前缀规范 + 禁止 AI 署名/生成标记。
# 规范见 AGENTS.md「Commit & Pull Request Guidelines」；逃生通道：git commit --no-verify。

if [ $# -ne 1 ] || [ ! -f "$1" ]; then
  echo "commit-msg 钩子缺少消息文件参数（git 调用时自动传入）" >&2
  exit 1
fi

MSG_FILE="$1"
FIRST_LINE="$(head -n1 "$MSG_FILE")"

if ! printf '%s\n' "$FIRST_LINE" | grep -qE '^(批次[0-9]+-)?(feat|fix|docs|chore):'; then
  echo "提交被拒绝：首行必须以 feat:/fix:/docs:/chore: 开头（可叠加 批次N- 序号），前缀后接中文描述。" >&2
  echo "示例：feat: 新增 XX 功能 / fix: 修复 XX 问题 / docs: 更新 XX 文档 / chore: 重构 XX 模块" >&2
  exit 1
fi

if grep -qiE 'Co-Authored-By|Assisted-by|Generated by|Crush' "$MSG_FILE"; then
  echo "提交被拒绝：禁止 Co-Authored-By / Assisted-by / Generated by 等 AI 署名或生成标记。" >&2
  exit 1
fi

exit 0
